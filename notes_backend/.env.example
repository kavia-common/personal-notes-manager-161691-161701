# Copy this file to .env and adjust values as needed. The orchestrator will map these.
# Networking
HOST=0.0.0.0
PORT=3001
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Security
FLASK_SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600

# CORS
CORS_ORIGINS=*

# Database (default falls back to SQLite in app/config.py if not set)
# NOTES_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/notes_db
# DATABASE_URL=sqlite:///notes.db
