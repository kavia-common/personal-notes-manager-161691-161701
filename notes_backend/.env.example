# Example environment variables for notes_backend
# Do NOT commit real secrets. Orchestrator will set .env in runtime.

# Server
PORT=3001
HOST=0.0.0.0
FLASK_DEBUG=0

# Security
FLASK_SECRET_KEY=replace-with-random-string
JWT_SECRET_KEY=replace-with-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600

# Database (use the connection string to the notes_database dependency)
# If using Postgres:
# NOTES_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/notesdb
# For local development (SQLite fallback):
# NOTES_DATABASE_URL=sqlite:///notes.db

# CORS
CORS_ORIGINS=*
